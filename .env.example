# ===========================================
# Aham Portfolio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ===========================================
# OpenAI (admin AI-assist features)
# ===========================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ===========================================
# Admin Login (required for /login and /admin)
# ===========================================
# The single admin account. Sign-in fails with
# "Admin credentials are not configured on the server" if these are missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=your-random-session-secret

# ===========================================
# Vercel Blob Storage (for document uploads)
# ===========================================
# Get this from Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ===========================================
# Application URL
# ===========================================
# Used for CORS and redirects
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Security (for local admin creation)
# ===========================================
# Used for password hashing in scripts/create-admin.ts
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-for-password-hashing

# ===========================================
# Script Variables (only for running scripts)
# ===========================================
# Only used when running utility scripts like create-admin.ts
# ADMIN_NAME=Admin User
